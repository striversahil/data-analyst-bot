[deploy]
  name = "data-analyst-bot"
  region = "singapore"
  runtime = "python3.12"
  buildCommand = "pip install -r requirements.txt"
  startCommand = "python main.py"
  envVars:
    - key: BOT_TOKEN
      secret: true
    - key: LOG_PUBLIC_URL
      value: "https://data-analyst-bot.railway.app/logs"
    - key: PORT
      value: "8080"
  volumes:
    - name: logs
      mountPath: /app/logs
      size: 1GB